#!/bin/env bash 

function CheckConfigFile() {
    CONFIG_FILE="$HOME/config/config.ini"

    echo "Config File: $CONFIG_FILE"
    echo " "

    # Check if the config file exists
    if [[ ! -f "$CONFIG_FILE" ]]; then
        echo "Error: Config file '$CONFIG_FILE' not found."
        # exit 1
    fi
}

function ReadConfigINI() { # Fixed by Google AI 11/23/2026.
    local config_file="$1"

    [[ -f "$config_file" ]] || return 1

    # Read and export variables from the config file
    while IFS='=' read -r key value || [[ -n "$key" ]]; do
        # Remove leading/trailing whitespace from key and value
        key="${key#"${key%%[![:space:]]*}"}"
        key="${key%"${key##*[![:space:]]}"}"
        value="${value#"${value%%[![:space:]]*}"}"
        value="${value%"${value##*[![:space:]]}"}"

        # Skip comments, section headers, and empty lines
        if [[ "$key" =~ ^[[:space:]]*[#\;] || "$key" =~ ^\[.*\] || -z "$key" ]]; then
            continue
        fi

        # Export the variable
        export "$key=$value"
    done < "$config_file"
}


function ExportConfigVars() { # Fixed by Google AI 11/23/2026.
    local config_file="${1:-$CONFIG_FILE}"

    if [[ ! -f "$config_file" ]]; then
        echo "Error: Config file '$config_file' not found." >&2
        return 1
    fi

    while IFS='=' read -r key value || [[ -n "$key" ]]; do
        # Skip empty lines, comments (# or ;), and section headers ([section])
        [[ -z "$key" || "$key" =~ ^[[:space:]]*[#\;] || "$key" =~ ^[[:space:]]*\[ ]] && continue

        # Trim leading and trailing whitespace
        key="${key#"${key%%[![:space:]]*}"}"
        key="${key%"${key##*[![:space:]]}"}"
        value="${value#"${value%%[![:space:]]*}"}"
        value="${value%"${value##*[![:space:]]}"}"

        # Strip optional surrounding single or double quotes from value
        value="${value%\"}"
        value="${value#\"}"
        value="${value%\'}"
        value="${value#\'}"

        # Validate key is a legal Bash variable name before exporting
        if [[ "$key" =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]]; then
            export "$key=$value"
            echo "Exported: $key=$value"
        else
            echo "Warning: Skipping invalid variable name '$key'" >&2
        fi
    done < "$config_file"

    echo "Variables from $config_file exported successfully."
}
