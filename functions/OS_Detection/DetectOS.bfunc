# shellcheck source=/dev/null

# Determine the distro
# Here are some known OSes:
# - On Mac: Darwin
# - On FreeBSD or GhostBSD: FreeBSD
# - On Fedora: fedora
# - On Ubuntu: ubuntu
# - On Raspbian: raspbian

DetectOS() {
    if [[ -f /etc/os-release ]]; then
        # Run in a subshell to avoid polluting the global namespace
        (
            source /etc/os-release
            printf '%s\n' "${ID,,}"
        )
    else
        # Fallback for macOS (Darwin), FreeBSD, etc., normalized to lowercase
        uname -s | tr '[:upper:]' '[:lower:]'
    fi
}



## Usage ##
#
#
   case "${DetectOS}" in
    raspbian)
        echo "This is Raspbian"
        ;;
    fedora)
        echo "This is Fedora"
        ;;
    ubuntu)
        echo "This is Ubuntu"
        ;;
    Darwin)
        echo "This is macOS"
        ;;
    *)
        echo "Unknown OS: ${DetectOS}"
        ;;
esac


