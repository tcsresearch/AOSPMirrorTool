MaintenenceTasks.bfunc - various functions related to maintenence of an AOSP mirror.

function CleanPartialSync() {
  find .repo -name "tmp_pack_*" -delete
}

function CheckAndroidSourceVersion() {
	echo "Checking Android Source Version..."
	cd AOSP_Source || return
	git --git-dir .repo/manifests.git log -1
	cd - || return
}

